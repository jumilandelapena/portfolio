{
  "name": "portfolio",
  "version": "2.0.0",
  "private": true,
  "description": "Portfolio of Jumilan L. Dela Peña: Astro, Tailwind CSS v4, TypeScript, tested with Playwright.",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4321",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "astro check && tsc --noEmit",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:visual:update": "playwright test --project=visual --update-snapshots",
    "test:external-links": "playwright test --project=chromium --grep @external",
    "lhci": "lhci autorun",
    "status:write": "node scripts/write-test-status.ts",
    "favicons": "node scripts/gen-favicons.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "4.3.4",
    "astro": "7.4.5",
    "satori": "0.63.2",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.16.0",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "globals": "17.14.0",
    "jiti": "2.7.0",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.2",
    "prettier-plugin-tailwindcss": "0.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
