---
import Base from '../layouts/Base.astro';
import { url } from '../site.config';
---

<Base title="Page not found" description="That page does not exist on this site." path="/404">
  <section class="mx-auto max-w-site px-4 py-24 sm:px-6" aria-labelledby="nf-title">
    <p class="m-0 font-mono text-sm text-muted">404</p>
    <h1 id="nf-title" class="mt-3 text-3xl font-semibold">
      Page not found
    </h1>
    <p class="mt-4 text-muted">That address does not exist here. Everything on this site lives on one page.</p>
    <p class="mt-8">
      <a href={url('/')} class="btn btn-primary">
        Back to the start
      </a>
    </p>
  </section>
</Base>
