---
import { getCollection } from 'astro:content';

import { dateTimeAttr, formatPartialDate } from '../lib/format';

import Section from './Section.astro';

const roles = (await getCollection('experience')).sort((a, b) => a.data.order - b.data.order);
const education = await getCollection('education');
---

<Section
  id="experience"
  title="Experience"
  intro="Four years at ClinicMind, from writing the help system to testing the product to building it."
>
  <ol class="reveal-stagger relative ml-1 border-l border-line">
    {roles.map((role, index) => (
      <li id={`experience-${role.id}`} class="relative pb-10 pl-7 last:pb-0" style={`--i: ${index}`}>
        <span
          class="absolute top-2 -left-[5px] size-[9px] rounded-full border-2 border-bg bg-accent-fill"
          aria-hidden="true"
        />
        <h3 class="text-lg font-semibold">{role.data.role}</h3>
        <p class="mt-0.5 max-w-none text-sm">
          <span class="font-medium">{role.data.org}</span>
          {role.data.orgNote && <span class="text-muted"> · {role.data.orgNote}</span>}
        </p>
        <p class="mt-0.5 max-w-none font-mono text-xs text-muted">
          <time datetime={dateTimeAttr(role.data.start)}>{formatPartialDate(role.data.start)}</time>
          {' to '}
          <time datetime={dateTimeAttr(role.data.end)}>{formatPartialDate(role.data.end)}</time>
        </p>
        {role.data.summary && <p class="mt-3 text-sm">{role.data.summary}</p>}
        <ul class="mt-3 list-disc space-y-1.5 pl-5 text-sm marker:text-muted">
          {role.data.highlights.map((h) => (
            <li>{h}</li>
          ))}
        </ul>
        {role.data.stack.length > 0 && (
          <ul class="mt-4 flex flex-wrap gap-1.5" aria-label="Stack">
            {role.data.stack.map((item) => (
              <li class="rounded-sm border border-line px-2 py-0.5 font-mono text-xs text-muted">{item}</li>
            ))}
          </ul>
        )}
      </li>
    ))}
  </ol>

  <h3 class="mt-14 text-lg font-semibold">Education</h3>
  <ul class="reveal mt-4 space-y-4">
    {education.map((e) => (
      <li>
        <p class="m-0 max-w-none font-medium">{e.data.degree}</p>
        <p class="m-0 max-w-none text-sm text-muted">
          {e.data.school}
          {e.data.schoolShort && <> ({e.data.schoolShort})</>} · <time datetime={e.data.start}>{e.data.start}</time> to{' '}
          <time datetime={e.data.end}>{e.data.end}</time>
        </p>
        {e.data.notes.map((note) => (
          <p class="mt-2 text-sm">{note}</p>
        ))}
      </li>
    ))}
  </ul>
</Section>
