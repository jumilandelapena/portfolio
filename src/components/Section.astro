---
interface Props {
  id: string;
  title: string;
  intro?: string | undefined;
  /** Visually lighter treatment for the secondary disciplines. */
  quiet?: boolean;
}

const { id, title, intro, quiet = false } = Astro.props;
---

<section
  id={id}
  aria-labelledby={`${id}-title`}
  class:list={['border-t border-line', quiet ? 'py-12' : 'py-16 sm:py-20']}
>
  <div class="mx-auto max-w-site px-4 sm:px-6">
    <h2 id={`${id}-title`} class:list={['font-semibold', quiet ? 'text-xl text-muted' : 'text-2xl']}>
      {title}
    </h2>
    {intro && <p class="mt-3 text-muted">{intro}</p>}
    <div class="mt-8">
      <slot />
    </div>
  </div>
</section>
