---
/**
 * Dark / light switch. The initial theme is applied by the inline script in
 * `Base.astro`; this button only flips it and remembers the choice.
 */
---

<button type="button" id="theme-toggle" class="icon-btn" aria-label="Switch to light theme">
  <svg
    class="size-[18px] [[data-theme='light']_&]:hidden"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
  <svg
    class="size-[18px] [[data-theme='dark']_&]:hidden"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.75"
    aria-hidden="true"
  >
    <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a7 7 0 1 0 10.5 10.5Z"></path>
  </svg>
</button>

<script>
  const button = document.getElementById('theme-toggle');
  const root = document.documentElement;
  const media = window.matchMedia('(prefers-color-scheme: light)');

  function current(): 'dark' | 'light' {
    return root.getAttribute('data-theme') === 'light' ? 'light' : 'dark';
  }

  function apply(theme: 'dark' | 'light', persist: boolean): void {
    root.setAttribute('data-theme', theme);
    button?.setAttribute('aria-label', `Switch to ${theme === 'dark' ? 'light' : 'dark'} theme`);
    if (persist) {
      try {
        localStorage.setItem('theme', theme);
      } catch {
        /* storage unavailable */
      }
    }
  }

  apply(current(), false);

  button?.addEventListener('click', () => {
    apply(current() === 'dark' ? 'light' : 'dark', true);
  });

  // Follow the OS only while the visitor has not chosen explicitly.
  media.addEventListener('change', (event) => {
    let saved: string | null = null;
    try {
      saved = localStorage.getItem('theme');
    } catch {
      /* storage unavailable */
    }
    if (saved !== 'light' && saved !== 'dark') apply(event.matches ? 'light' : 'dark', false);
  });
</script>
