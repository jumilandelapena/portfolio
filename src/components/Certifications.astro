---
import { getCollection } from 'astro:content';

import { certificationAreas } from '../content.config';
import { formatDateOnly, formatPartialDate } from '../lib/format';

import Section from './Section.astro';

const areaLabels: Record<(typeof certificationAreas)[number], string> = {
  qa: 'QA',
  development: 'Development',
  ai: 'AI',
  pm: 'PM',
  data: 'Data',
  marketing: 'Marketing',
};

const certifications = (await getCollection('certifications')).sort((a, b) => a.data.order - b.data.order);
const courses = (await getCollection('courses')).sort((a, b) => a.data.order - b.data.order);
const coursesFor = (id: string) => courses.filter((c) => c.data.certification.id === id);
---

<Section
  id="certifications"
  title="Certifications"
  intro="Verified Coursera credentials, newest first. Every specialization and course title links to its certificate."
>
  <div
    class="flex flex-wrap items-center gap-2"
    role="group"
    aria-label="Filter certifications by area"
    data-filter-group="certifications"
  >
    <button type="button" class="filter-chip" data-filter="all" aria-pressed="true">
      All
    </button>
    {certificationAreas.map((area) => (
      <button type="button" class="filter-chip" data-filter={area} aria-pressed="false">
        {areaLabels[area]}
      </button>
    ))}
    <p class="m-0 ml-auto max-w-none font-mono text-xs text-muted" aria-live="polite" data-filter-count>
      {certifications.length} of {certifications.length}
    </p>
  </div>

  <ul class="reveal-stagger mt-8 divide-y divide-line border-y border-line" data-filter-items>
    {certifications.map((cert, index) => {
      const certCourses = coursesFor(cert.id);
      return (
        <li id={`cert-${cert.id}`} data-areas={cert.data.areas.join(' ')} class="py-6" style={`--i: ${index}`}>
          <h3 class="text-lg font-semibold">
            {cert.data.url ? (
              <a href={cert.data.url} rel="noopener noreferrer" class="link" data-testid="certification-link">
                {cert.data.title}
              </a>
            ) : (
              cert.data.title
            )}
          </h3>
          <p class="mt-1 max-w-none font-mono text-xs text-muted">
            {cert.data.provider} · {cert.data.year}
            {cert.data.completed && <> · completed {formatPartialDate(cert.data.completed)}</>}
            {' · '}
            {cert.data.areas.map((a) => areaLabels[a]).join(', ')}
          </p>
          <p class="mt-3 text-sm">{cert.data.description}</p>
          {certCourses.length > 0 && (
            <details class="mt-3 text-sm" open={index === 0}>
              <summary class="cursor-pointer font-medium text-muted">
                {certCourses.length} course certificate{certCourses.length === 1 ? '' : 's'}
              </summary>
              <ol class="mt-3 grid gap-x-6 gap-y-1.5 sm:grid-cols-2">
                {certCourses.map((course) => (
                  <li>
                    <a href={course.data.url} rel="noopener noreferrer" class="link-prose" data-testid="course-link">
                      {course.data.title}
                    </a>
                    {(course.data.provider || course.data.completed) && (
                      <span class="block font-mono text-xs text-muted">
                        {[course.data.provider, course.data.completed && formatDateOnly(course.data.completed)]
                          .filter(Boolean)
                          .join(' · ')}
                      </span>
                    )}
                  </li>
                ))}
              </ol>
            </details>
          )}
        </li>
      );
    })}
  </ul>
</Section>

<script>
  import { initFilter } from '../scripts/filter';

  initFilter('certifications');
</script>
